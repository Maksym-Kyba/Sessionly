# Production configuration for infra/docker-compose.prod.yml.
# Copy to infra/.env on the server (never commit it) and replace every placeholder.
# Replace <domain> with the site_domain Terraform output, for example 3-120-45-67.sslip.io.

SITE_DOMAIN=<domain>

# Database. Use a long random alphanumeric password, for example from `openssl rand -hex 24`.
POSTGRES_USER=sessionly
POSTGRES_PASSWORD=
POSTGRES_DB=sessionly

# Backend
APP_ENV=production
CORS_ALLOWED_ORIGINS=["https://<domain>"]
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
DEFAULT_PSYCHOLOGIST_TIME_ZONE=Europe/Kyiv

# Google OAuth web client. Register this exact redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<domain>/api/v1/auth/google/callback

FRONTEND_AUTH_SUCCESS_URL=https://<domain>/dashboard
FRONTEND_AUTH_ERROR_URL=https://<domain>/
FRONTEND_AUTH_REDIRECT_ALLOWLIST=["https://<domain>/dashboard", "https://<domain>/"]

# Generate as described in the root README (Fernet key and a random token of 32+ characters).
OAUTH_STATE_ENCRYPTION_KEY=
CSRF_SECRET_KEY=
