# Copy to terraform.tfvars (not committed) and fill in your own values.

# The public IP address of each administrator with /32, for example ["203.0.113.10/32"].
ssh_allowed_cidrs = ["203.0.113.10/32"]

# Optional overrides:
# aws_profile         = "sessionly"
# aws_region          = "eu-north-1"
# ssh_public_key_path = "~/.ssh/sessionly.pub"
