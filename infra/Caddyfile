# Caddy obtains and renews the HTTPS certificate for SITE_DOMAIN automatically.
# Access logging is intentionally not enabled: OAuth callback URLs carry codes in the query string.

{$SITE_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
