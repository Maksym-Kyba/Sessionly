# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_ENV=development

# Backend CORS allowlist (JSON array; do not use a wildcard in production).
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Local PostgreSQL development credentials only. Replace for shared or deployed environments.
POSTGRES_USER=sessionly
POSTGRES_PASSWORD=sessionly_local
POSTGRES_DB=sessionly

# Use this URL when running the backend directly on the host.
DATABASE_URL=postgresql+psycopg://sessionly:sessionly_local@localhost:15432/sessionly

# Use this URL when the backend runs as a Docker Compose service on the compose network.
DATABASE_URL_DOCKER=postgresql+psycopg://sessionly:sessionly_local@db:5432/sessionly

# Tests create and drop a uniquely named database using this local PostgreSQL connection.
TEST_DATABASE_URL=postgresql+psycopg://sessionly:sessionly_local@localhost:15432/sessionly_test

# Psychologist Google OAuth. Obtain the client credentials from the team's Google Cloud project.
# The callback URI must exactly match a URI registered for the OAuth web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Both redirect targets must appear exactly in this allowlist. Configure production URLs as HTTPS.
FRONTEND_AUTH_SUCCESS_URL=http://localhost:3000/
FRONTEND_AUTH_ERROR_URL=http://localhost:3000/
FRONTEND_AUTH_REDIRECT_ALLOWLIST=["http://localhost:3000/"]

# Generate an encryption key with Fernet.generate_key() and a separate random CSRF secret.
OAUTH_STATE_ENCRYPTION_KEY=
CSRF_SECRET_KEY=
DEFAULT_PSYCHOLOGIST_TIME_ZONE=Europe/Kyiv
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=sessionly_session
OAUTH_BROWSER_COOKIE_NAME=sessionly_oauth_browser
SESSION_COOKIE_SAMESITE=lax
# Local HTTP only. Set true for the HTTPS production deployment behind Caddy.
SESSION_COOKIE_SECURE=false

# Client email verification. This value is for local development only; use a unique random secret
# in every deployed environment. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
CLIENT_VERIFICATION_SECRET_KEY=local-development-only-change-me-32
# The frontend verification page reads the token from the URL fragment and POSTs it to the API.
CLIENT_VERIFICATION_LINK_BASE_URL=http://localhost:3000/verify-email
# Current implementation: 30-minute email/grant lifetime and 90-day client access-token lifetime.
CLIENT_VERIFICATION_TTL_SECONDS=1800
CLIENT_BOOKING_TOKEN_TTL_SECONDS=7776000
